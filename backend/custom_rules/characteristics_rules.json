  "regex_rules": [
    {
      "name": "debit_range_litres",
      "key": "debit",
      "pattern": "\\b(\\d+(?:[.,]\\d+)?)\\s*[/\\-]\\s*(\\d+(?:[.,]\\d+)?)\\s*l(?:itres?)?\\b",
      "value_template": "{1}-{2} L"
    },
    {
      "name": "debit_l_min_range",
      "key": "debit",
      "pattern": "\\b(\\d+(?:[.,]\\d+)?)\\s*[/\\-]\\s*(\\d+(?:[.,]\\d+)?)\\s*(?:l/min|lpm)\\b",
      "value_template": "{1}-{2} L/min"
    },
    {
      "name": "debit_l_min_single",
      "key": "debit",
      "pattern": "\\b(\\d+(?:[.,]\\d+)?)\\s*(?:l/min|lpm)\\b",
      "value_template": "{1} L/min"
    },
    {
      "name": "voltage_inline",
      "key": "tension",
      "pattern": "\\b(\\d+(?:[.,]\\d+)?)\\s*v\\b",
      "value_template": "{1} V"
    },
    {
      "name": "voltage_range",
      "key": "tension",
      "pattern": "\\b(\\d+(?:[.,]\\d+)?)\\s*[-/]\\s*(\\d+(?:[.,]\\d+)?)\\s*v\\b",
      "value_template": "{1}-{2} V"
    },
    {
      "name": "frequency_range",
      "key": "frequence",
      "pattern": "\\b(\\d+(?:[.,]\\d+)?)\\s*[-/]\\s*(\\d+(?:[.,]\\d+)?)\\s*hz\\b",
      "value_template": "{1}-{2} Hz"
    },
    {
      "name": "frequency_single",
      "key": "frequence",
      "pattern": "(?<![/\\-])\\b(\\d+(?:[.,]\\d+)?)\\s*hz\\b",
      "value_template": "{1} Hz"
    },
    {
      "name": "power_inline",
      "key": "puissance",
      "pattern": "\\b(\\d+(?:[.,]\\d+)?)\\s*(kw|w)\\b",
      "value_template": "{1} {2}"
    },
    {
      "name": "pressure_bar",
      "key": "pression",
      "pattern": "\\b(\\d+(?:[.,]\\d+)?)\\s*bar\\b",
      "value_template": "{1} bar"
    },
    {
      "name": "temperature_range",
      "key": "temperature",
      "pattern": "\\b([+-]?\\d+(?:[.,]\\d+)?)\\s*[-/]\\s*([+-]?\\d+(?:[.,]\\d+)?)\\s*(?:c|degc|degree c|\\u00b0c)\\b",
      "value_template": "{1}-{2} C"
    },
    {
      "name": "temperature_single",
      "key": "temperature",
      "pattern": "\\b([+-]?\\d+(?:[.,]\\d+)?)\\s*(?:c|degc|degree c|\\u00b0c)\\b",
      "value_template": "{1} C"
    },
    {
      "name": "capacity_l",
      "key": "capacite",
      "pattern": "\\b(\\d+(?:[.,]\\d+)?)\\s*(?:l|litre|litres)\\b",
      "value_template": "{1} L"
    },
    {
      "name": "capacity_ml",
      "key": "capacite",
      "pattern": "\\b(\\d+(?:[.,]\\d+)?)\\s*ml\\b",
      "value_template": "{1} mL"
    },
    {
      "name": "weight_kg",
      "key": "poids",
      "pattern": "\\b(\\d+(?:[.,]\\d+)?)\\s*kg\\b",
      "value_template": "{1} kg"
    },
    {
      "name": "dimensions_3d",
      "key": "dimensions",
      "pattern": "\\b(\\d+(?:[.,]\\d+)?)\\s*[x\\u00d7*]\\s*(\\d+(?:[.,]\\d+)?)\\s*[x\\u00d7*]\\s*(\\d+(?:[.,]\\d+)?)\\s*(mm|cm|m)\\b",
      "value_template": "{1} x {2} x {3} {4}"
    },
    {
      "name": "dimensions_2d",
      "key": "dimensions",
      "pattern": "\\b(\\d+(?:[.,]\\d+)?)\\s*[x\\u00d7*]\\s*(\\d+(?:[.,]\\d+)?)\\s*(mm|cm|m)\\b",
      "value_template": "{1} x {2} {3}"
    },
    {
      "name": "class_token",
      "key": "classe",
      "pattern": "\\bclasse\\s*([a-z])\\b",
      "value_template": "{1}"
    },
    {
      "name": "gauge_g",
      "key": "taille",
      "pattern": "\\b(\\d{1,2}(?:[.,]\\d+)?)\\s*g\\b",
      "value_template": "{1} G"
    },
    {
      "name": "fr_ch",
      "key": "taille",
      "pattern": "\\b(\\d{1,3}(?:[.,]\\d+)?)\\s*(fr|ch)\\b",
      "value_template": "{1} {2}"
    },
    {
      "name": "pack_xqty",
      "key": "conditionnement",
      "pattern": "\\b(?:pack|lot|carton|boite|box|sachet|blister)\\s*(?:x|\\u00d7)?\\s*(\\d{1,5})\\b",
      "value_template": "{1}"
    },
    {
      "name": "pack_box_qty",
      "key": "conditionnement",
      "pattern": "\\b(?:boite|box|sachet|blister|pack|lot|carton)\\s*(?:de)?\\s*(\\d{1,5})\\b",
      "value_template": "{1}"
    },
    {
      "name": "reference_token",
      "key": "reference",
      "pattern": "\\b(?:ref|reference|sku|model\\s*no|part\\s*number)\\b\\s*[:#\\-]?\\s*([a-z0-9][a-z0-9_\\-./]{1,80})\\b",
      "value_group": 1
    }
  ],
  "row_family_tokens": {}
}
