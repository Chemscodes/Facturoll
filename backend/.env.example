APP_DB_URL=postgresql+psycopg://trial_user:trial_pass@127.0.0.1:5432/trial_db
# DB schema management mode:
# - legacy (default): create_all + compatibility migrations (current behavior)
# - alembic_strict: require DB at Alembic head, fail fast otherwise
APP_DB_SCHEMA_MODE=legacy
APP_URL=http://127.0.0.1:8000
WEBHOOK_TOKEN=
GOOGLE_PROJECT_ID=
GOOGLE_LOCATION=us
GOOGLE_PROCESSOR_ID=
# Optional: dedicated OCR processor ID for non-invoice PDFs.
GOOGLE_OCR_PROCESSOR_ID=129bb15d3edca788
GOOGLE_CREDENTIALS_PATH=
GMAIL_CREDENTIALS_PATH=D:/SAAS/backend/credentials.json
GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/gmail/oauth/callback
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_THRESHOLD=0.85
OPENAI_CHARACTERISTICS_MATCH_THRESHOLD=0.60
OPENAI_MATCH_CONFIRM_THRESHOLD=0.90
OPENAI_MATCH_VERIFY_THRESHOLD=0.80
# Product matching mode for invoice line -> requested product:
# embedding (default) | gpt | gpt_hybrid
OPENAI_PRODUCT_MATCH_MODE=gpt
OPENAI_PRODUCT_MATCH_MODEL=gpt-5.1
# Minimum GPT confidence to accept GPT-picked product name before fallback.
OPENAI_PRODUCT_MATCH_MIN_CONFIDENCE=0.30
# Number of candidate requested products sent to GPT per invoice line.
OPENAI_PRODUCT_MATCH_TOP_K=15
# 1 = call GPT only for uncertain embedding zone, 0 = call GPT for every line
OPENAI_PRODUCT_MATCH_GPT_UNCERTAIN_ONLY=1
# Embedding zone where GPT is allowed (outside this zone, no GPT call)
OPENAI_PRODUCT_MATCH_GPT_TRIGGER_MIN=0.35
OPENAI_PRODUCT_MATCH_GPT_TRIGGER_MAX=0.88
OPENAI_PRODUCT_MATCH_TIMEOUT_SECONDS=75
OPENAI_PRODUCT_MATCH_RETRY_ATTEMPTS=3
OPENAI_PRODUCT_MATCH_RETRY_BACKOFF_SECONDS=1.5
OPENAI_PRODUCT_MATCH_GPT_MAX_CALLS_PER_RUN=120
OPENAI_PRODUCT_MATCH_FALLBACK_MODEL=gpt-5.3
# Strict gate used by status assignment in GPT mode:
# gpt_score < threshold OR absent => TO_VERIFY (no auto-confirm)
OPENAI_PRODUCT_MATCH_STRICT_MIN_CONFIDENCE=0.50
# GPT product-match score blend:
# final_gpt_score = name_weight*name_core_similarity + model_weight*gpt_confidence
OPENAI_PRODUCT_MATCH_GPT_NAME_WEIGHT=0.60
OPENAI_PRODUCT_MATCH_GPT_MODEL_WEIGHT=0.40
OPENAI_PRODUCT_MATCH_FORCE_TO_VERIFY_ON_GPT_MISS=1
# Campaign requested qty auto-fill fallback (PJ extraction -> campaign_items.requested_qty)
# Local matching first, GPT only for unresolved/ambiguous/complex names.
OPENAI_CAMPAIGN_QTY_GPT_ENABLED=1
OPENAI_CAMPAIGN_QTY_GPT_MODEL=gpt-5.1
OPENAI_CAMPAIGN_QTY_GPT_TIMEOUT_SECONDS=35
OPENAI_CAMPAIGN_QTY_GPT_RETRY_ATTEMPTS=3
OPENAI_CAMPAIGN_QTY_GPT_RETRY_BACKOFF_SECONDS=1.0
OPENAI_CAMPAIGN_QTY_GPT_FALLBACK_MODEL=gpt-5.3
OPENAI_CAMPAIGN_QTY_GPT_TOP_K=12
OPENAI_CAMPAIGN_QTY_GPT_MIN_CONFIDENCE=0.60
OPENAI_CAMPAIGN_QTY_GPT_TRIGGER_GAP=0.03
OPENAI_CAMPAIGN_QTY_GPT_MAX_CALLS_PER_RUN=80
OPENAI_USAGE_LOG_ENABLED=1
# Optional local cost estimation. Leave 0 if you only want tokens/latency/cache visibility.
OPENAI_PRICE_DEFAULT_INPUT_PER_1M=0
OPENAI_PRICE_DEFAULT_OUTPUT_PER_1M=0
OPENAI_PRICE_GPT_51_INPUT_PER_1M=0
OPENAI_PRICE_GPT_51_OUTPUT_PER_1M=0
OPENAI_PRICE_GPT_54_INPUT_PER_1M=0
OPENAI_PRICE_GPT_54_OUTPUT_PER_1M=0
OPENAI_PRICE_GPT_41_INPUT_PER_1M=0
OPENAI_PRICE_GPT_41_OUTPUT_PER_1M=0
OPENAI_PRICE_TEXT_EMBEDDING_3_SMALL_INPUT_PER_1M=0
OPENAI_PRICE_TEXT_EMBEDDING_3_LARGE_INPUT_PER_1M=0
# Extraction mode for campaign attachments:
# heuristic | hybrid | smart | llm_structured
OPENAI_ATTACHMENT_EXTRACTION_MODE=llm_structured
OPENAI_ATTACHMENT_MODEL=gpt-5.1
# Optional stronger fallback model used when smart retry detects unstable output
OPENAI_ATTACHMENT_STRONG_MODEL=gpt-5.4
# 1 = enable retry with strong model on unstable extraction, 0 = disable
OPENAI_ATTACHMENT_SMART_RETRY=1
OPENAI_ATTACHMENT_TIMEOUT_SECONDS=120
OPENAI_ATTACHMENT_MIN_CONFIDENCE=0.20
# Independent threshold for "a_verifier" badge
OPENAI_ATTACHMENT_VERIFY_CONFIDENCE=0.70
OPENAI_ATTACHMENT_MAX_INPUT_CHARS=90000
# 1 = strict (rows too weak -> unassigned), 0 = show all as products with "a_verifier"
OPENAI_ATTACHMENT_FAIL_CLOSED=1
# Tech-sheet extraction mode:
# heuristic (default) | llm
OPENAI_TECH_SHEET_EXTRACTION_MODE=llm_structured
OPENAI_TECH_SHEET_MODEL=gpt-5.1
OPENAI_TECH_SHEET_TIMEOUT_SECONDS=90
OPENAI_TECH_SHEET_MAX_INPUT_CHARS=50000
# Tech-sheet conformity comparison mode:
# local (default) | gpt
OPENAI_TECH_SIMILARITY_MODE=local
OPENAI_TECH_SIMILARITY_MODEL=gpt-5.1
OPENAI_TECH_SIMILARITY_TIMEOUT_SECONDS=60
OPENAI_TECH_SIMILARITY_RETRY_ATTEMPTS=3
OPENAI_TECH_SIMILARITY_RETRY_BACKOFF_SECONDS=1.0
OPENAI_TECH_SIMILARITY_FALLBACK_MODEL=gpt-5.3
OPENAI_TECH_SIMILARITY_MAX_INPUT_CHARS=30000
# 1 = call GPT only for uncertain local-tech score, 0 = always GPT in gpt mode
OPENAI_TECH_SIMILARITY_GPT_UNCERTAIN_ONLY=1
OPENAI_TECH_SIMILARITY_GPT_TRIGGER_MIN=0.45
OPENAI_TECH_SIMILARITY_GPT_TRIGGER_MAX=0.75
# Invoice-line offered components extraction mode:
# local | gpt
OPENAI_INVOICE_COMPONENTS_MODE=local
OPENAI_INVOICE_COMPONENTS_MODEL=gpt-5.1
OPENAI_INVOICE_COMPONENTS_STRICT_MODEL=
OPENAI_INVOICE_COMPONENTS_TIMEOUT_SECONDS=45
OPENAI_INVOICE_COMPONENTS_RETRY_ATTEMPTS=3
OPENAI_INVOICE_COMPONENTS_RETRY_BACKOFF_SECONDS=1.0
OPENAI_INVOICE_COMPONENTS_FALLBACK_MODEL=gpt-5.3
OPENAI_INVOICE_COMPONENTS_MAX_INPUT_CHARS=5000
# Save GPT structured components in invoice item notes (cached as b64 token).
OPENAI_INVOICE_COMPONENTS_SAVE_TO_NOTES=1
# Warm invoice component extraction at /invoices/{id}/extract and rematch.
OPENAI_INVOICE_COMPONENTS_PRECOMPUTE_ON_EXTRACT=1
# Automatic invoice fallback (only for suspect low-confidence rows):
# Trigger: gpt_score < OPENAI_INVOICE_FALLBACK_MIN_GPT_SCORE (or missing) AND suspect row
# (unknown/admin/duplicate/inconsistent qty*price vs amount).
OPENAI_INVOICE_FALLBACK_ENABLED=1
OPENAI_INVOICE_FALLBACK_MODEL=gpt-5.1
OPENAI_INVOICE_FALLBACK_MIN_GPT_SCORE=0.50
OPENAI_INVOICE_FALLBACK_TIMEOUT_SECONDS=60
OPENAI_INVOICE_FALLBACK_MAX_INPUT_CHARS=40000
OPENAI_INVOICE_FALLBACK_MIN_SUSPECT_COUNT=1
# Safe rollout flag for Document AI fallback evolution.
# 0 = current behavior, 1 = v2 path enabled.
DOC_AI_FALLBACK_V2_ENABLED=0

# Medical lexicon for product name normalization/matching
MEDICAL_LEXICON_ENABLED=1
MEDICAL_LEXICON_PATH=D:/SAAS/backend/custom_rules/medical_lexicon.json
MEDICAL_LEXICON_MIN_SCORE=0.58
MEDICAL_LEXICON_AUTOCORRECT_SCORE=0.88
# Help LLM structured extraction with medical lexicon hints (non-blocking)
OPENAI_ATTACHMENT_LEXICON_HINTS_ENABLED=1
OPENAI_ATTACHMENT_LEXICON_HINTS_MAX_ENTRIES=40
OPENAI_ATTACHMENT_LEXICON_HINTS_MAX_ALIASES=2
OPENAI_ATTACHMENT_LEXICON_HINTS_MAX_CHARS=3500
# Optional: JSON file with custom characteristics rules (extra synonyms/regex/features).
CUSTOM_CHARACTERISTICS_RULES_PATH=D:/SAAS/backend/custom_rules/characteristics_rules.json
# Optional: stores manual anchor-linking correction examples used for learning.
ANCHOR_LINKING_EXAMPLES_PATH=D:/SAAS/backend/custom_rules/anchor_linking_examples.json

# Gmail sync (backend/scripts/gmail_fetch.py)
# Scheduler control for /admin/gmail-sync endpoints.
# Windows (schtasks) task name:
# GMAIL_SYNC_TASK_NAME=SAAS Gmail Sync
# Linux (systemd) units:
# GMAIL_SYNC_TIMER_UNIT=saas-gmail-sync.timer
# GMAIL_SYNC_SERVICE_UNIT=saas-gmail-sync.service
GMAIL_SYNC_TASK_NAME=SAAS Gmail Sync
GMAIL_SYNC_TIMER_UNIT=saas-gmail-sync.timer
GMAIL_SYNC_SERVICE_UNIT=saas-gmail-sync.service

# Default query (if GMAIL_FETCH_QUERY is empty):
# has:attachment filename:pdf newer_than:${GMAIL_FETCH_LOOKBACK_DAYS}d
GMAIL_FETCH_LOOKBACK_DAYS=2
GMAIL_FETCH_MAX_RESULTS=10
# Safe optional image-import pass:
# 0 = unchanged behavior (PDF/XLSX only), 1 = add JPG/JPEG/PNG/WEBP pass
GMAIL_FETCH_INCLUDE_IMAGES=0
# Optional image query override when include-images is enabled:
# GMAIL_FETCH_IMAGE_QUERY=has:attachment (filename:jpg OR filename:jpeg OR filename:png OR filename:webp) newer_than:2d
# Optional: only sync one user account (debug/ops)
# GMAIL_FETCH_USER_ID=1
# Optional full Gmail query override:
# GMAIL_FETCH_QUERY=has:attachment filename:pdf newer_than:2d
